# ══════════════════════════════════════════════════════════════════════
#  Live Trader — environment variables template
#  Copy this file to config/.env and fill in your real values.
#  NEVER commit config/.env to git.
# ══════════════════════════════════════════════════════════════════════

# ── Binance Futures API ───────────────────────────────────────────────
# Create API keys at https://www.binance.com/en/my/settings/api-management
# Required permissions: Enable Futures, Enable Reading (no withdrawal needed)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ── Binance Futures Testnet (for paper mode) ──────────────────────────
# Create testnet keys at https://testnet.binancefuture.com/
BINANCE_TESTNET_API_KEY=your_testnet_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_secret_here

# ── Telegram ──────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram to create a bot → get TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot to get your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Redis ─────────────────────────────────────────────────────────────
# Override the defaults in settings.yaml if your Redis is not local
REDIS_HOST=localhost
REDIS_PORT=6379
